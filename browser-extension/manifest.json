{
  "manifest_version": 3,
  "name": "AI Usage — Browser Bridge",
  "description": "Send Claude and Gemini quota summaries from your signed-in tabs to AI Usage on this Mac.",
  "version": "0.3.0",
  "permissions": ["storage", "alarms"],
  "host_permissions": ["https://gemini.google.com/*", "https://claude.ai/*", "http://127.0.0.1:49627/*"],
  "background": { "service_worker": "background.js" },
  "action": { "default_popup": "popup.html", "default_title": "AI Usage" },
  "content_scripts": [
    {
      "matches": ["https://gemini.google.com/*"],
      "js": ["gemini-parser.js", "content-runtime.js", "gemini-content.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://claude.ai/*"],
      "js": ["claude-parser.js", "content-runtime.js", "claude-content.js"],
      "run_at": "document_idle"
    }
  ]
}
